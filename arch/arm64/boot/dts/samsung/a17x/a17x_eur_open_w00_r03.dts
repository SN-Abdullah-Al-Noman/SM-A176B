					adc_array = <0x14c 0x1b7 0x23a 0x2d5 0x38b 0x458 0x534 0x621 0x713 0x809 0x8f2 0x9d1 0xaa2 0xb5b 0xc03 0xc95 0xd16 0xd84 0xde2 0xe33 0xe77 0xeb0 0xee0>;
