/dts-v1/;

/ {
	compatible = "SAMSUNG,A17X_EUR_OPEN\0SAMSUNG,S5E8535";
	board_id = <0x00>;
	board_rev = <0x00>;
	dtbo-hw_rev = <0x03>;
	dtbo-hw_rev_end = <0x03>;

	fragment@smd {
		target-path = "/";

		__overlay__ {

			samsung_mobile_device {
				compatible = "simple-bus";
				phandle = <0x83>;

				sec_vibrator {
					status = "okay";
					compatible = "sec_vibrator";
					haptic,normal_ratio = <0x64>;
					haptic,high_temp_ref = <0x30>;
					haptic,high_temp_ratio = <0x41>;
				};

				vibrator_info {
					status = "okay";
					compatible = "samsung,vib-info";
					functions = [00];
					samsung,intensities;
					samsung,haptic_intensities;
					phandle = <0x84>;
				};

				input_booster {
					status = "okay";
					compatible = "input_booster";
					max_resource_count = "7";
					max_cluster_count = "3";
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					cpu_cluster_policy = "7,4,0";
					ib_release_values = "0,0,0,0,0,0,0";
					allowed_resources = "1,3,4";

					booster_key@1 {
						input_booster,label = "key";
						input_booster,type = <0x00>;
						input_booster,head_time = <0x1f4>;
						input_booster,tail_time = <0x00>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x177000 0x00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0x00 0x00>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@2 {
						input_booster,label = "touchkey";
						input_booster,type = <0x01>;
						input_booster,head_time = <0x00>;
						input_booster,tail_time = <0xc8>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x177000 0x00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0x00 0x00>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
							};
						};
					};

					booster_key@3 {
