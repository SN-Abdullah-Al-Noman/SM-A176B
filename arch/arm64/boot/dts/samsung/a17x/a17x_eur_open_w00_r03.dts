				sec-auth-sle956681 {
					status = "okay";
					compatible = "samsung,sec_auth_sle956681";
					authon,power_mode = "indirect";
					authon,1tau_value = <0x3c>;
					authon,3tau_value = <0xb4>;
					authon,5tau_value = <0x12c>;
					authon,response_timeout_value = <0x1194>;
					authon,swi_gpio = <0xffffffff 0x00 0x00>;
					authon,eur_detection = <0x02 0x00 0x00>;
