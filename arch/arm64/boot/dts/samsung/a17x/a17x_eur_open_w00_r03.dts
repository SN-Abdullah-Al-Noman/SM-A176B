	fragment@common {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;

			argos {
				compatible = "samsung,argos";
				#address-cells = <0x01>;
			};
		};
	};

	fragment@model {
		target-path = "/";

		__overlay__ {
			#address-cells = <0x02>;
			#size-cells = <0x01>;
			model = "Samsung A17X EUR OPEN board based on S5E8535";

			shub {
				pinctrl-names = "default";
				compatible = "shub";
				acc-lsm6dsvtr-position = <0x05>;
				mag-mxg4300s-position = <0x00>;
				mag-mxg4300s-array = [26 7e 02 4d 00 f5 01 ef 26 3b ff 53 ff ba ff ea 28 4b 00 00 00 00 00 00 00 00 00];
				light-position = <0x2b 0x48 0x09 0x2d 0x03 0x00>;
				brightness-array-len = <0x0b>;
				brightness-array = <0x13 0x30 0x36 0x3a 0x3f 0x43 0x46 0x49 0x4b 0x4d 0x64>;
			};

			samsung,reloc_gpio {
				compatible = "samsung,reloc_gpio";
				status = "okay";
				sec,gpio-label = "reloc_gpio";
				sec,reloc-base = <0x00>;
				phandle = <0x92>;
			};

			sec-bootstat {

				thermal-zones {

					zone_big {
						zone-name = "BIG";
						display-name = "BIG";
					};

					zone_lit {
						zone-name = "LITTLE";
						display-name = "LIT";
					};

					zone_g3d {
						zone-name = "G3D";
						display-name = "G3D";
					};

					zone_isp {
						zone-name = "ISP";
						display-name = "ISP";
					};
				};
			};

			secgpio_dvs {
				compatible = "samsung,s5e8535-secgpio-dvs";
				status = "okay";
			};

			sec_pm_debug {
				compatible = "samsung,sec-pm-debug";
				status = "okay";
			};

			gpio_keys {
				status = "okay";
				compatible = "gpio-keys";
				pinctrl-names = "default";
				pinctrl-0 = <0x15 0x16>;

				button@3 {
					label = "gpio-keys: KEY_VOLUMEUP";
					linux,code = <0x73>;
					gpios = <0xffffffff 0x00 0x0f>;
					gpio-key,wakeup;
					debounce-interval = <0x0f>;
				};
			};

			sec-reboot {
				compatible = "samsung,sec-reboot";
				samsung,syscon-phandle = <0xffffffff>;
				shutdown-offset = <0x30c>;
				shutdown-trigger = <0x100>;
				magic-inform = <0x808>;
				panic-inform = <0x80c>;
			};

			hs_tune {
				hs_tune_cnt = <0x07>;
				phandle = <0x66>;

				hs_tune1 {
					tune_name = "tx_pre_emp";
					tune_value = <0x02 0x02>;
				};

				hs_tune2 {
					tune_name = "tx_vref";
					tune_value = <0x06 0x06>;
				};

				hs_tune3 {
					tune_name = "rx_sqrx";
					tune_value = <0x05 0x05>;
				};

				hs_tune4 {
					tune_name = "utmi_clk";
					tune_value = <0x01 0x01>;
				};

				hs_tune5 {
					tune_name = "compdis";
					tune_value = <0x06 0x06>;
				};

				hs_tune6 {
					tune_name = "tx_res";
					tune_value = <0x02 0x02>;
				};

				hs_tune7 {
					tune_name = "tx_rise";
					tune_value = <0x01 0x01>;
				};
			};

			gnss_mailbox {
				status = "okay";
				compatible = "samsung,exynos-gnss-mailbox";
				reg = <0x00 0x11a50000 0x200>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x2d 0x04>;
				mbox,name = "gnss_mailbox";
				mbox,id = <0x00>;
				num_shared_reg = <0x04>;
				shared_reg_offset = <0x100>;
				use_sw_reset_reg = <0x00>;
				phandle = <0x17>;
			};

			gnssif {
				status = "okay";
				compatible = "samsung,exynos-gnss";
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x1c 0x04 0x00 0x11b 0x04 0x00 0x11a 0x04 0x00 0x119 0x01>;
				interrupt-names = "ACTIVE\0WATCHDOG\0WAKEUP\0SW_INIT";
				shmem,name = "KEPLER";
				device_node_name = "gnss_ipc";
				mbox_info = <0x17>;
				mbx,int_bcmd = <0x00>;
				mbx,int_req_fault_info = <0x01>;
				mbx,int_ipc_msg = <0x02>;
				mbx,int_ack_wake_set = <0x03>;
				mbx,int_ack_wake_clr = <0x04>;
				mbx,irq_bcmd = <0x00>;
				mbx,irq_rsp_fault_info = <0x01>;
				mbx,irq_ipc_msg = <0x02>;
				mbx,irq_req_wake_clr = <0x04>;
				mbx,irq_simple_lock = <0x0f>;
				mbx,reg_bcmd_ctrl = <0x00 0x01 0x02 0x03>;
				memory-region = <0xffffffff>;
				reg_rx_ipc_msg = <0x01 0x05>;
				reg_tx_ipc_msg = <0x01 0x04>;
				reg_rx_head = <0x01 0x03>;
				reg_rx_tail = <0x01 0x02>;
				reg_tx_head = <0x01 0x01>;
				reg_tx_tail = <0x01 0x00>;
				fault_info = <0x01 0x200000 0x180000>;
				shmem,code_offset = <0x00>;
				shmem,code_allowed_size = <0x380000>;
				shmem,ipc_offset = <0x380000>;
				shmem,ipc_size = <0x80000>;
				shmem,ipc_rx_offset = <0x00>;
				shmem,ipc_rx_size = <0x40000>;
				shmem,ipc_tx_offset = <0x40000>;
				shmem,ipc_tx_size = <0x3ff80>;
				shmem,ipc_reg_offset = <0x7ff80>;
				shmem,ipc_reg_size = <0x80>;

				baaw_configuration {
					window_cnt = <0x08>;

					window_0 {
						baaw,sfr_addr = <0x13fe0000>;
						baaw,start = <0xb19c0>;
						baaw,end = <0xb19d0>;
						baaw,ap_start = <0x119c0>;
						baaw,authority = <0x80000003>;
					};

					window_1 {
						baaw,sfr_addr = <0x13fe0010>;
						baaw,start = <0xb1a40>;
						baaw,end = <0xb1a50>;
						baaw,ap_start = <0x11a40>;
						baaw,authority = <0x80000003>;
					};

					window_2 {
						baaw,sfr_addr = <0x13fe0020>;
						baaw,start = <0xb1a50>;
						baaw,end = <0xb1a60>;
						baaw,ap_start = <0x11a50>;
						baaw,authority = <0x80000003>;
					};

					window_3 {
						baaw,sfr_addr = <0x13fe0030>;
						baaw,start = <0xb18e0>;
						baaw,end = <0xb18f0>;
						baaw,ap_start = <0x118e0>;
						baaw,authority = <0x80000003>;
					};

					window_4 {
						baaw,sfr_addr = <0x13fe0040>;
						baaw,start = <0xb1b80>;
						baaw,end = <0xb1b90>;
						baaw,ap_start = <0x11b80>;
						baaw,authority = <0x80000003>;
					};

					window_5 {
						baaw,sfr_addr = <0x13fe0050>;
						baaw,start = <0x60000>;
						baaw,end = <0x60600>;
						baaw,ap_start = <0xee000>;
						baaw,authority = <0x80000003>;
					};

					window_6 {
						baaw,sfr_addr = <0x13fe0060>;
						baaw,start = <0xa0000>;
						baaw,end = <0xa0600>;
						baaw,ap_start = <0xee000>;
						baaw,authority = <0x80000003>;
					};

					window_7 {
						baaw,sfr_addr = <0x13fe0070>;
						baaw,start = <0xb18f0>;
						baaw,end = <0xb1900>;
						baaw,ap_start = <0x118f0>;
						baaw,authority = <0x80000003>;
					};
				};
			};

			vbat {
				compatible = "regulator-fixed";
				regulator-name = "VBAT";
				regulator-min-microvolt = <0x401640>;
				regulator-max-microvolt = <0x401640>;
				regulator-boot-on;
				phandle = <0x93>;
			};

			audio-codec-dummy {
				compatible = "snd-soc-dummy";
				#sound-dai-cells = <0x00>;
				phandle = <0x94>;
			};

			audio-cpu-dummy {
				compatible = "samsung,dummy-cpu";
				#sound-dai-cells = <0x00>;
				phandle = <0x95>;
			};

			sec-audio-sysfs {
				compatible = "samsung,audio-sysfs";
				status = "okay";
				audio,no-earjack;
				audio,num-amp = <0x01>;
			};

			sec-audio-debug {
				compatible = "samsung,audio-debug";
				status = "okay";
				abox_dbg_size_min = <0x600000>;
				abox_slog_size_min = <0x00>;
			};

			abox-synchronized-ipc {
				compatible = "samsung,abox-synchronized-ipc";
				status = "okay";
				abox = <0xffffffff>;
			};

