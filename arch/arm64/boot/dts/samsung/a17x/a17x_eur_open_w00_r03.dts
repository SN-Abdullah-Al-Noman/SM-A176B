						vci-off {
							type = <0x04>;
							reg = <0x24>;
							phandle = <0x2d>;
						};

						vdd3-off {
							type = <0x04>;
							reg = <0x25>;
							phandle = <0x2e>;
						};

						delay-1ms {
							type = <0x01>;
							value = <0x01>;
							phandle = <0x29>;
						};

						delay-10ms {
							type = <0x01>;
							value = <0x0a>;
							phandle = <0x2a>;
						};

						reset-high {
							type = <0x07>;
							gpio = <0x26>;
							phandle = <0x2b>;
