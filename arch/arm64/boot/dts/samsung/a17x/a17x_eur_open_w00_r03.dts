					phandle = <0x8d>;
				};

				sec-auth-ds28e30 {
					status = "okay";
					compatible = "samsung,sec_auth_ds28e30";
					ds28e30,rw_out_low_loop_cnt = <0x03 0x03>;
					ds28e30,read_bit_vamm_cnt = <0x06>;
					ds28e30,rw_out_low_loop_cnt2 = <0x03 0x03>;
					ds28e30,read_bit_vamm_cnt2 = <0x06>;
					sec_auth_ds28e30,swi_gpio = <0xffffffff 0x00 0x00>;
					ds28e30,swi_gpio = <0xffffffff 0x00 0x00>;
					ds28e30,base_phys_addr = <0x11430000 0x1000>;
					ds28e30,offset = <0x40 0x44>;
					ds28e30,bit_pos = <0x00 0x00>;
					ds28e30,cpu_start = <0x04>;
					ds28e30,cpu_end = <0x06>;
					ds28e30,eur_detection = <0x02 0x00 0x00>;
					pinctrl-names = "pulldown";
					pinctrl-0 = <0x13>;
					phandle = <0x8e>;
				};

				sec-direct-charger {
					status = "okay";
					compatible = "samsung,sec-direct-charger";
					charger,battery_name = "battery";
					charger,main_charger = "s2mf301-charger";
					charger,direct_charger = "sm5461-charger";
					charger,dchg_min_current = <0x7d0>;
					charger,ta_alert_wa;
