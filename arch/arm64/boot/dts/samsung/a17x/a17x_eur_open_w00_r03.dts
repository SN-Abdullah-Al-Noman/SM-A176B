					phandle = <0x89>;
				};

				sec_thermistor@3 {
					compatible = "samsung,sec-thermistor";
					status = "okay";
					thermistor_name = "sec-wf-thermistor";
					id = <0x03>;
					io-channels = <0x01 0x05>;
					io-channel-names = "adc-wf-temp";
					io-channel-ranges;
					adc_array = <0x111 0x141 0x17a 0x1bd 0x20c 0x26a 0x2d7 0x357 0x3e7 0x48e 0x547 0x618 0x6f4 0x7de 0x8d5 0x9c8 0xab6 0xb94 0xc62 0xd1b 0xdb6 0xe3a 0xea7>;
