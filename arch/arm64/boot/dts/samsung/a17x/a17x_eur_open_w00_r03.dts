						input_booster,type = <0x02>;
						input_booster,head_time = <0x82>;
						input_booster,tail_time = <0x1f4>;

						inputbooster,resource {
							compatible = "resource";

							resource@1 {
								resource,label = "cluster1";
								resource,value = <0x119400 0x101d00>;
							};

							resource@4 {
								resource,label = "mif";
								resource,value = <0xf78f0 0xf78f0>;
							};

							resource@5 {
								resource,label = "int";
								resource,value = <0x00 0x00>;
