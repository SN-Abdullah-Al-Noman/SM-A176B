					};

					sequences {
						panel_boot_on = <0x27 0x28>;
						panel_power_on = <0x28 0x29 0x27 0x2a 0x2b 0x29 0x2c 0x29 0x2b 0x2a>;
						panel_power_off = <0x2c 0x29 0x2d 0x2a 0x2e>;
