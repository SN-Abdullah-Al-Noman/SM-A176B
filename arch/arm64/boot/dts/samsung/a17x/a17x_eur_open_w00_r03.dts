						panel-name = "db7f2010b_a17x";
						ap-vendor-setting = <0x2f>;
						display-mode = <0x30>;
						power-ctrl = <0x31>;
						freq-hop = <0x32>;
						dqe-suffix = "db7f2010b_a17x";
						id-mask = <0x800040 0xf000f0 0x00 0x00>;
						phandle = <0x3e>;
					};

					s6e8fc3_a17x {
						panel-name = "s6e8fc3_a17x";
						ap-vendor-setting = <0x33>;
						display-mode = <0x34>;
						power-ctrl = <0x35>;
						dqe-suffix = "s6e8fc3_a17";
						id-mask = <0x800000 0xfffff0>;
						phandle = <0x3f>;
					};
				};

				s6e8fc3_a17x_power_ctrl {
					phandle = <0x35>;

					actions {

						vci-on {
							type = <0x03>;
							reg = <0x24>;
							phandle = <0x36>;
						};

						vdd3-on {
							type = <0x03>;
							reg = <0x25>;
							phandle = <0x37>;
						};

						vci-off {
							type = <0x04>;
							reg = <0x24>;
							phandle = <0x3c>;
						};

						vdd3-off {
							type = <0x04>;
							reg = <0x25>;
							phandle = <0x3d>;
						};

						delay-1ms {
							type = <0x01>;
							value = <0x01>;
							phandle = <0x38>;
						};

						delay-10ms {
							type = <0x01>;
							value = <0x0a>;
							phandle = <0x39>;
						};

						reset-high {
							type = <0x07>;
							gpio = <0x26>;
							phandle = <0x3a>;
						};

						reset-low {
							type = <0x08>;
							gpio = <0x26>;
							phandle = <0x3b>;
						};
					};

					sequences {
						panel_boot_on = <0x36 0x37>;
						panel_power_on = <0x37 0x38 0x36 0x39 0x3a 0x38 0x3b 0x38 0x3a 0x39>;
						panel_power_off = <0x3b 0x38 0x3c 0x38 0x3d>;
					};
				};

				s6e8fc3_a17x_ap {
					size = <0x47 0x9a>;
					hdr_num = <0x00>;
					vendor_pps_enable = <0x01>;
					initial_xmit_delay = <0x200>;
					initial_dec_delay = <0x20e>;
					scale_increment_interval = <0x45a>;
					final_offset = <0x10f0>;
					nfl_bpg_offset = <0x22f>;
					slice_bpg_offset = <0x243>;
					phandle = <0x33>;
				};

				panel-lut {
					panel_0 = <0x3e>;
					panel_1 = <0x3f>;
				};

				gpios {

					disp-reset {
						gpios = <0xffffffff 0x00 0x01>;
						dir = <0x00>;
						irq-type = <0x00>;
						phandle = <0x26>;
					};

					disp-det {
						gpios = <0xffffffff 0x00 0x01>;
						dir = <0x01>;
						irq-type = <0x02>;
						phandle = <0x97>;

						irq-pend {
							reg = <0x00 0x15850a34 0x00>;
							bit = <0x02>;
						};
					};

					err-fg {
						gpios = <0xffffffff 0x00 0x00>;
						dir = <0x01>;
						irq-type = <0x2001>;
						phandle = <0x98>;
					};

					conn-det {
						gpios = <0xffffffff 0x03 0x00>;
						dir = <0x01>;
						irq-type = <0x2001>;
						phandle = <0x99>;
					};

					pcd {
						gpios = <0xffffffff 0x00 0x01>;
						dir = <0x01>;
						irq-type = <0x02>;
						phandle = <0x9a>;
					};

					disp-te {
						gpios = <0xffffffff 0x01 0x00>;
						dir = <0x01>;
						irq-type = <0x00>;
						phandle = <0x9b>;
					};
				};

				regulators {

					ddi-vci {
						regulator = <0x40>;
						type = <0x01>;
						def-voltage = <0x2dc6c0>;
						phandle = <0x24>;
					};

					ddi-vdd3 {
						regulator = <0x41>;
						type = <0x01>;
						def-voltage = <0x1b7740>;
						phandle = <0x25>;
					};
				};
			};
		};
	};

