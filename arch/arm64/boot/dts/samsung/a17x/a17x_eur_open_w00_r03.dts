	fragment@sec_debug {
		target-path = "/";

		__overlay__ {

			sec_debug {
				compatible = "samsung,sec_debug";
				status = "okay";
				memory-region = <0x1a>;
				bdev_path = "/dev/block/by-name/debug";
			};
		};
	};

	fragment@sec_debug_built {
		target-path = "/";

		__overlay__ {

			sec_debug_built {
				compatible = "samsung,sec_debug_built";
				status = "okay";
				memory-region = <0x1a>;
			};
		};
	};

	fragment@sec_debug_test {
		target-path = "/";

		__overlay__ {

			sec_debug_test_device {
				compatible = "samsung,sec_debug_test";
				status = "okay";
			};
		};
	};

	fragment@sec_debug_reset_reason {
		target-path = "/";

		__overlay__ {

			sec_debug_reset_reason {
				compatible = "samsung,sec_debug_reset_reason";
				power_off_src = "OVP\0OI\0LDO_OI\0RSV3\0RSV4\0RSV5\0RSV6\0RSV7\0SUB_OFF\0TSD\0TIMEOUT\0LDO_SYS_OK\0PWRHOLD\0WTSR_TOUT\0SMPL_TOUT\0UVLOB";
				power_on_src = "PWRON\0JIGONB\0ACOKB\0MRST\0ALARM\0INST_ACOKB\0SMPL\0WTSR";
				rst_stat = "CLUSTER0_DBGSRSTREQ0\0CLUSTER0_DBGSRSTREQ1\0CLUSTER0_DBGSRSTREQ2\0CLUSTER0_DBGSRSTREQ3\0CLUSTER0_DBGSRSTREQ4\0CLUSTER0_DBGSRSTREQ5\0CLUSTER1_DBGSRSTREQ0\0CLUSTER1_DBGSRSTREQ1\0RSVD8\0RSVD9\0RSVD10\0RSVD11\0RSVD12\0RSVD13\0RSVD14\0RSVD15\0PINRESET\0RSVD17\0RSVD18\0RSVD19\0APM_CPU_WDTRESET\0RSVD21\0RSVD22\0CHUB_WDTRESET\0CLUSTER0_WDTRESET\0CLUSTER1_WDTRESET\0AUD_CPU0_WDTRESET\0RSVD27\0DBGC_CPU_WDTRESET\0WRESET\0SWRESET";
			};
		};
	};

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			sec_debug_next {
				reg = <0x00 0x91200000 0x200000>;
				no-map;
				phandle = <0x1a>;
			};
		};
	};

